          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="103" name="Exit Script"/>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[JSONGetElement ( $response ; "running" )]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$running</Name>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[$running]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$state</Name>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "repo_path" ; ConvertFromFileMakerPath ( JSONGetElement ( $$AGENTIC.FM ; "path" ) ; 1 ) ; JSONString ]
)]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$payload</Name>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[$running]]></Calculation>
        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["Stop webviewer?"]]></Calculation>
          </Title>
          <Message>
            <Calculation><![CDATA["The agentic-fm webviewer is running at:¶¶http://localhost:8080¶¶Stop it?"]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["Stop"]]></Calculation>
            </Button>
            <Button CommitState="False">
              <Calculation><![CDATA["Cancel"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[Get ( LastMessageChoice ) = 1]]></Calculation>
        </Step>
        <Step enable="True" id="160" name="Insert from URL">
          <NoInteract state="True"/>
          <DontEncodeURL state="False"/>
          <SelectAll state="True"/>
          <VerifySSLCertificates state="False"/>
          <CURLOptions>
            <Calculation><![CDATA["-X POST -H \"Content-Type: application/json\" -d " & Quote ( $payload )]]></Calculation>
          </CURLOptions>
          <Calculation><![CDATA[$server & "/webviewer/stop"]]></Calculation>
          <Text/>
          <Field>$response</Field>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[Get ( LastError )]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$httpError</Name>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[$httpError ≠ 0 or not JSONGetElement ( $response ; "success" )]]></Calculation>
        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["Error"]]></Calculation>
          </Title>
          <Message>
            <Calculation><![CDATA[If ( $httpError ≠ 0 ; "Could not reach the companion server." ; JSONGetElement ( $response ; "error" ) )]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="69" name="Else">
          <Restore state="False"/>
        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["Webviewer stopped"]]></Calculation>
          </Title>
          <Message>
            <Calculation><![CDATA["The agentic-fm webviewer has been stopped."]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[False]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$state</Name>
        </Step>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="69" name="Else">
          <Restore state="False"/>
        </Step>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Start the webviewer.</Text>
        </Step>
        <Step enable="True" id="160" name="Insert from URL">
          <NoInteract state="True"/>
          <DontEncodeURL state="False"/>
          <SelectAll state="True"/>
          <VerifySSLCertificates state="False"/>
          <CURLOptions>
            <Calculation><![CDATA["-X POST -H \"Content-Type: application/json\" -d " & Quote ( $payload )]]></Calculation>
          </CURLOptions>
          <Calculation><![CDATA[$server & "/webviewer/start"]]></Calculation>
          <Text/>
          <Field>$response</Field>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[Get ( LastError )]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$httpError</Name>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[$httpError ≠ 0 or not JSONGetElement ( $response ; "success" )]]></Calculation>
        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["Error"]]></Calculation>
