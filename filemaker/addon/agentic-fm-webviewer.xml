      <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="5" name="Agentic-fm Menu">
        <Step enable="True" id="89" name="# (comment)">
          <Text>PURPOSE: Handle all menu calls from a custom menu and pass through to a web viewer.</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>NOTE: This relies on a custom menu set being attached to the layout where the agentic-fm web viewer object is being used.</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
          </Value>
          <Name>$action</Name>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[Left ( $action ; 5 ) = "agfm."]]></Calculation>
        </Step>
        <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
          <ObjectName>
            <Calculation><![CDATA["agentic-fm"]]></Calculation>
          </ObjectName>
          <FunctionName>
            <Calculation><![CDATA["triggerAppAction"]]></Calculation>
          </FunctionName>
          <Parameters Count="1">
            <P>
              <Calculation><![CDATA[$action]]></Calculation>
            </P>
          </Parameters>
        </Step>
        <Step enable="True" id="125" name="Else If">
          <Restore state="False"/>
          <Calculation><![CDATA[$action = "editor.action.clipboardPasteAction"]]></Calculation>
        </Step>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Handle special case of pasting when clipboard has more than just text.</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)">
          <Text>WebKit paste fails when rich/binary formats (XMSS, RTF, scrap styles) are on the pasteboard.</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Known issue with MBS: If FileMaker objects are copied to the clipboard they won't paste unless switching out of FileMaker and coming back.</Text>
        </Step>
        <Step enable="True" id="48" name="Paste">
          <NoStyle state="True"/>
          <SelectAll state="True"/>
          <LinkAvail state="False"/>
          <Field table="Table" id="13" name="CLIPBOARD"/>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[Table::CLIPBOARD]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$text</Name>
        </Step>
        <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
          <ObjectName>
            <Calculation><![CDATA["agentic-fm"]]></Calculation>
          </ObjectName>
          <FunctionName>
            <Calculation><![CDATA["insertAtEditorCursor"]]></Calculation>
          </FunctionName>
          <Parameters Count="1">
            <P>
              <Calculation><![CDATA[$text]]></Calculation>
            </P>
          </Parameters>
        </Step>
        <Step enable="True" id="103" name="Exit Script"/>
        <Step enable="True" id="69" name="Else">
          <Restore state="False"/>
        </Step>
        <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
          <ObjectName>
            <Calculation><![CDATA["agentic-fm"]]></Calculation>
          </ObjectName>
          <FunctionName>
            <Calculation><![CDATA["triggerEditorAction"]]></Calculation>
          </FunctionName>
          <Parameters Count="1">
            <P>
              <Calculation><![CDATA[$action]]></Calculation>
            </P>
          </Parameters>
        </Step>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="103" name="Exit Script"/>
        <Step enable="True" id="89" name="# (comment)"/>
      </Script>
      <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="18" name="Agentic-fm Paste">
        <Step enable="True" id="89" name="# (comment)">
          <Text>PURPOSE: Open a script tab in Script Workspace. Used by Tier 2 deployment via companion /trigger.</Text>
        </Step>
        <Step enable="False" id="61" name="Insert Text">
          <SelectAll state="False"/>
          <Text>CALLED BY: companion server /trigger endpoint via AppleScript&#xD;  The companion sets the job via POST /pending before firing do script.&#xD;  This script GETs /pending to retrieve: target (script name).&#xD;&#xD;PARAMETERS (from /pending JSON):&#xD;  target &#x2014; name of the script to open in Script Workspace&#xD;&#xD;RETURNS: JSON { success, script } or { success, error }&#xD;&#xD;REQUIRES: MBS Plugin with ScriptWorkspace functions&#xD;&#xD;NOTE: This script only OPENS the target script tab. The actual paste&#xD;  (AXPress tab focus + Cmd+A + Delete + Cmd+V + Cmd+S) is handled by&#xD;  deploy.py via a second raw_applescript call through the companion.&#xD;  AXPress must run from outside FM &#x2014; Perform AppleScript within FM&#xD;  causes Script Workspace to lose focus on the step editor.</Text>
          <Field>$README</Field>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Fetch the pending job from the companion server</Text>
        </Step>
        <Step enable="True" id="160" name="Insert from URL">
          <NoInteract state="True"/>
          <DontEncodeURL state="False"/>
          <SelectAll state="False"/>
          <VerifySSLCertificates state="False"/>
          <Calculation><![CDATA["http://" & If ( IsEmpty ( $$AGENTIC.FM.COMPANION.IP ) ; "localhost" ; $$AGENTIC.FM.COMPANION.IP ) & ":8765/pending"]]></Calculation>
          <Text/>
          <Field>$pendingJSON</Field>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[JSONGetElement ( $pendingJSON ; "target" )]]></Calculation>
          </Value>
          <Name>$target</Name>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[IsEmpty ( $target )]]></Calculation>
        </Step>
        <Step enable="True" id="103" name="Exit Script">
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "success" ; False ; JSONBoolean ] ;
	[ "error" ; "No pending job — companion /pending returned empty" ; JSONString ]
)]]></Calculation>
        </Step>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Bring FM to front before opening Script Workspace</Text>
        </Step>
        <Step enable="True" id="67" name="Perform AppleScript">
          <ContentType value="Text"/>
          <Text>tell me to activate</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="88" name="Open Script Workspace"/>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[MBS ( "ScriptWorkspace.OpenScript" ; $target )]]></Calculation>
          </Value>
          <Name>$openResult</Name>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[Left ( $openResult ; 5 ) ≠ "OK"]]></Calculation>
        </Step>
        <Step enable="True" id="103" name="Exit Script">
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "success" ; False ; JSONBoolean ] ;
	[ "error" ; "ScriptWorkspace.OpenScript failed: " & $openResult ; JSONString ]
)]]></Calculation>
        </Step>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="103" name="Exit Script">
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "success" ; True ; JSONBoolean ] ;
	[ "script" ; $target ; JSONString ]
)]]></Calculation>
        </Step>
      </Script>
    </Group>
  </Group>
</fmxmlsnippet>
