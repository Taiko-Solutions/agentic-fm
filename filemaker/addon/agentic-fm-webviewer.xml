            <Calculation><![CDATA[If ( $httpError ≠ 0 ; "Could not reach the companion server." ; JSONGetElement ( $response ; "error" ) )]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
