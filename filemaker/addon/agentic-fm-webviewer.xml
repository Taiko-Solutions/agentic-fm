<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Group groupCollapsed="False" includeInMenu="False" id="1" name="agentic-fm">
    <Group groupCollapsed="False" includeInMenu="False" id="11" name="Extras">
      <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="9" name="Agentic-fm Webviewer">
        <Step enable="True" id="89" name="# (comment)">
          <Text>PURPOSE: Start or stop the agentic-fm webviewer from within FileMaker.</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>DEPENDENCY: The companion server must be running (agent/scripts/companion_server.py)</Text>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA["http://" & If ( IsEmpty ( $$AGENTIC.FM.COMPANION.IP ) ; "localhost" ; $$AGENTIC.FM.COMPANION.IP ) & ":8765"]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$server</Name>
        </Step>
        <Step enable="True" id="61" name="Insert Text">
          <SelectAll state="True"/>
          <Text>&lt;!DOCTYPE html&gt;&lt;html lang="en"&gt;&lt;head&gt;&lt;meta charset="UTF-8"&gt;&lt;meta name="viewport" content="width=device-width,initial-scale=1"&gt;&lt;style&gt;*{box-sizing:border-box;margin:0;padding:0}html,body{height:100%;width:100%}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,sans-serif;background:#0f0f0f;color:#e4e4e7;display:flex;align-items:center;justify-content:center;user-select:none}.card{text-align:center;padding:2rem;max-width:560px;width:100%}.icon{width:52px;height:52px;border-radius:50%;background:#1f1f1f;border:1px solid #2a2a2a;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:1.4rem}h1{font-size:1rem;font-weight:600;color:#f4f4f5;letter-spacing:-.01em;margin-bottom:.4rem}p{font-size:.8125rem;color:#71717a;line-height:1.65;margin-bottom:1.25rem}pre{background:#161616;border:1px solid #262626;border-radius:7px;padding:.65rem .9rem;font-family:ui-monospace,"SF Mono","Cascadia Code",monospace;font-size:.75rem;color:#a1a1aa;text-align:left;overflow:auto}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;div class="card"&gt;&lt;div class="icon"&gt;&#x26A1;&lt;/div&gt;&lt;h1&gt;Companion server offline&lt;/h1&gt;&lt;p&gt;Start the server, then run the script 'Agentic-fm webviewer' to launch agentic-fm.&lt;/p&gt;&lt;pre&gt;python3 agent/scripts/companion_server.py&lt;/pre&gt;&lt;/div&gt;&lt;/body&gt;&lt;/html&gt;</Text>
          <Field>$html</Field>
        </Step>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="1" name="Perform Script">
          <Calculated>
            <Calculation><![CDATA["Get agentic-fm path"]]></Calculation>
          </Calculated>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$pathResult</Name>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[not JSONGetElement ( $pathResult ; "ok" )]]></Calculation>
        </Step>
        <Step enable="True" id="1" name="Perform Script">
          <Calculated>
            <Calculation><![CDATA["AGFM Choose Folder"]]></Calculation>
          </Calculated>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[not Get ( ScriptResult )]]></Calculation>
        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["agentic-fm not configured"]]></Calculation>
          </Title>
          <Message>
            <Calculation><![CDATA["agentic-fm-app could not say which clone this file belongs to (" & JSONGetElement ( $pathResult ; "error" ) & ") and no folder was chosen.¶¶Register the clone in agentic-fm-app (Projects), or pick this solution's clone there if it is in several clones."]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="103" name="Exit Script"/>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Check webviewer status.</Text>
        </Step>
        <Step enable="True" id="160" name="Insert from URL">
          <NoInteract state="True"/>
          <DontEncodeURL state="False"/>
          <SelectAll state="True"/>
          <VerifySSLCertificates state="False"/>
          <Calculation><![CDATA[$server & "/webviewer/status"]]></Calculation>
