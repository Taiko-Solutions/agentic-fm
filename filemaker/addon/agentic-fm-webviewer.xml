        </Step>
        <Step enable="True" id="87" name="Show Custom Dialog">
          <Title>
            <Calculation><![CDATA["Webviewer started"]]></Calculation>
          </Title>
          <Message>
            <Calculation><![CDATA["The agentic-fm webviewer is now running at:¶¶http://localhost:8080"]]></Calculation>
          </Message>
          <Buttons>
            <Button CommitState="True">
              <Calculation><![CDATA["OK"]]></Calculation>
            </Button>
            <Button CommitState="False"/>
            <Button CommitState="False"/>
          </Buttons>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[True]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$state</Name>
        </Step>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="70" name="End If"/>
        <Step enable="True" id="89" name="# (comment)"/>
        <Step enable="True" id="89" name="# (comment)">
          <Text>Refresh any agentic-fm web viewer.</Text>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[Position ( LayoutObjectNames ( Get ( FileName ) ; Get ( LayoutName ) ) ; "agentic-fm" ; 1 ; 1 )]]></Calculation>
        </Step>
        <Step enable="True" id="68" name="If">
          <Restore state="False"/>
          <Calculation><![CDATA[$state = True]]></Calculation>
        </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Value>
            <Calculation><![CDATA[""]]></Calculation>
          </Value>
          <Repetition>
            <Calculation><![CDATA[1]]></Calculation>
          </Repetition>
          <Name>$html</Name>
        </Step>
        <Step enable="True" id="146" name="Set Web Viewer">
