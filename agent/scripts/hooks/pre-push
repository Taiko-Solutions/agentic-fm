#!/bin/bash
# agentic-fm pre-push hook — protección contra fuga de datos de cliente (Taiko)
#
# Cuatro capas, implementadas en agent/scripts/check_pushed_paths.py sobre las reglas
# de agent/scripts/hooks/paths.conf (las mismas que usan agentic-fm-safe-push y la
# GitHub Action del fork):
#
#   1. [forbidden] − [whitelist]: ficheros que NUNCA se versionan (xml_parsed, CONTEXT.json,
#      sandbox/*.xml, config/*.json…). Cualquier rama, cualquier repo.
#   2. Clon de cliente (repo SIN remote `upstream`): push a `taiko` o `trabajo` → bloqueado.
#      Las mejoras suben en una rama mejora/<tema> y entran en taiko por PR.
#   3. Clon de cliente, cualquier otra rama: todo fichero debe estar en [allow]
#      (capa herramientas). Un spec de cliente en docs/ no puede salir del clon.
#   4. Clon de cliente: tocar reglas sin añadir entrada en TAIKO-UPDATES.md → aviso.
#
# El repo base (el único con remote `upstream`) solo pasa la capa 1.
# Después, si el push toca catálogos/conversor/fmlint, corre agent/scripts/ci_checks.py.
#
# Instalación en un repo:   bash agent/scripts/install-hooks.sh
# No hay bypass: --no-verify va contra la política (la GitHub Action repite la comprobación).

set -e

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
ZERO_SHA="0000000000000000000000000000000000000000"

# Repo base = el único con remote `upstream` (petrowsky). Exento de reglas de rama/allowlist.
BASE_FLAG=""
if git remote get-url upstream >/dev/null 2>&1; then BASE_FLAG="--base-repo"; fi

# Script y reglas: primero la copia instalada junto al hook (install-hooks.sh la deja en
# .git/hooks/, independiente de la rama en checkout); si no, la del árbol de trabajo.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
CHECK=""; RULES_FLAG=""
if [ -f "$HOOK_DIR/check_pushed_paths.py" ] && [ -f "$HOOK_DIR/paths.conf" ]; then
    CHECK="$HOOK_DIR/check_pushed_paths.py"; RULES_FLAG="--rules $HOOK_DIR/paths.conf"
elif [ -f "agent/scripts/check_pushed_paths.py" ] && [ -f "agent/scripts/hooks/paths.conf" ]; then
    CHECK="agent/scripts/check_pushed_paths.py"
fi

found_violation=0
all_pushed_files=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO_SHA" ] && continue          # borrado de rama: permitido
    branch="${remote_ref#refs/heads/}"

    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        revs="$local_sha --not --remotes"               # rama nueva: todo lo que no esté ya en el remoto
    else
        revs="${remote_sha}..${local_sha}"
    fi
    files=$(git log -m --pretty=format: --name-only --diff-filter=d $revs 2>/dev/null | sort -u)
    all_pushed_files="$all_pushed_files
$files"

    if [ -n "$CHECK" ]; then
        # Capas 1–4 en una sola implementación (por commit, merges incluidos)
        if ! out=$(python3 "$CHECK" --branch "$branch" --revs "$revs" --repo . $RULES_FLAG $BASE_FLAG); then
            echo ""
            echo "$out"
            echo "  Rama:   $local_ref → $remote_ref"
            echo "  Remote: $REMOTE_NAME ($REMOTE_URL)"
            found_violation=1
        else
            [ -n "$out" ] && echo "$out"
        fi
    elif [ -z "$BASE_FLAG" ]; then
        # Clon sin el script disponible (instalación antigua + rama vieja): FAIL-CLOSED
        echo ""
        echo "❌ PUSH BLOQUEADO — no encuentro agent/scripts/check_pushed_paths.py ni su copia en .git/hooks/"
        echo "   Actualiza el clon (agentic-fm-sync) y reinstala el hook (bash agent/scripts/install-hooks.sh),"
        echo "   o haz el push desde una rama que contenga el script."
        found_violation=1
    else
        # Repo base sin el script (histórico): solo la capa de prohibidos
        FORBIDDEN_REGEX='^(xml_exports/|agent/xml_parsed/|agent/context/|agent/CONTEXT\.json$|agent/sandbox/.*\.xml$|agent/config/.*\.(json|md)$)'
        WHITELIST_REGEX='(\.example(\..*)?$|^agent/config/fmlint\.config\.json$|^agent/sandbox/script\.xml$)'
        matches=$(echo "$files" | grep -E "$FORBIDDEN_REGEX" | grep -vE "$WHITELIST_REGEX" || true)
        if [ -n "$matches" ]; then
            echo ""; echo "❌ PUSH BLOQUEADO — archivos prohibidos:"; echo "$matches" | sed 's/^/    /'
            found_violation=1
        fi
    fi
done

if [ $found_violation -eq 1 ]; then
    echo ""
    echo "Cómo resolver:"
    echo "  · Fichero prohibido: quítalo del commit (git reset --soft HEAD~1; git restore --staged <f>; git commit -c ORIG_HEAD)."
    echo "  · Rama taiko/trabajo desde un clon: crea mejora/<tema> desde taiko con solo los ficheros de la capa herramientas y abre PR."
    echo "  · Fichero legítimo fuera de la allowlist: amplía [allow] en agent/scripts/hooks/paths.conf (y reinstala el hook)."
    echo "  Nunca uses --no-verify para saltarte esto."
    exit 1
fi

# ---------------------------------------------------------------------------
# Sanity checks de artefactos críticos (catálogos JSON, conversor, fmlint)
#
# Si el push toca alguno de estos artefactos, corre agent/scripts/ci_checks.py
# (validación JSON de catálogos + tests del conversor + tests de fmlint).
# Evita que llegue a taiko un catálogo roto (caso real: coma faltante que
# invalidó todo el step-catalog) o un conversor que pierde parámetros.
# ---------------------------------------------------------------------------

CRITICAL_REGEX='^(agent/catalogs/.*\.json$|agent/scripts/fm_xml_to_snippet\.py$|agent/scripts/snippet_to_hr\.py$|agent/fmlint/)'

if echo "$all_pushed_files" | grep -qE "$CRITICAL_REGEX" 2>/dev/null; then
    echo "🔎 pre-push: el push toca artefactos críticos — corriendo sanity checks…"
    if ! python3 agent/scripts/ci_checks.py; then
        echo ""
        echo "❌ PUSH BLOQUEADO — sanity checks fallidos (agent/scripts/ci_checks.py)"
        echo "   Arregla los fallos y reintenta."
        exit 1
    fi
fi

exit 0
