#!/bin/bash
# agentic-fm-sync — actualiza este clon de cliente desde origin/taiko (modelo trabajo/taiko/mejora).
#   agentic-fm-sync             # fetch · taiko en avance rápido · merge en trabajo · novedades
#   agentic-fm-sync --migrar    # una vez por clon: crea trabajo, quita upstream, reinstala el hook
#   agentic-fm-sync --json      # salida máquina
# Usa el sync_clone.py del propio clon; si el clon aún no lo tiene (primera actualización),
# usa el que acompaña a este script (symlink al repo base).
set -euo pipefail
REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "❌ No estás en un repositorio git."; exit 1; }
SCRIPT="$REPO/agent/scripts/sync_clone.py"
if [ ! -f "$SCRIPT" ]; then
    SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
    SCRIPT="$(dirname "$SELF")/../sync_clone.py"
    [ -f "$SCRIPT" ] || { echo "❌ No encuentro sync_clone.py ni en el clon ni junto a este script."; exit 1; }
    echo "· el clon aún no tiene sync_clone.py: usando $(cd "$(dirname "$SCRIPT")" && pwd)/sync_clone.py"
fi
exec python3 "$SCRIPT" --repo "$REPO" "$@"
