#!/bin/bash
# Validación manual de políticas antes de un push agentic-fm.
#
# Es la segunda red de seguridad (la primera es .gitignore, la tercera es el
# hook pre-push global en .git/hooks/pre-push).
#
# Uso:
#   agentic-fm-safe-push --check                    # valida sin empujar
#   agentic-fm-safe-push --check <remote> <branch>
#   agentic-fm-safe-push --execute                  # valida y empuja
#   agentic-fm-safe-push --execute <remote> <branch>
#
# Política de ramas vigente:
#   - main   : espejo de upstream, bloqueado para push manual
#   - taiko  : solo desde el repo base; desde un clon está bloqueada (usa mejora/<tema> + PR)
#   - trabajo: rama local del clon, nunca se sube
#   - *      : desde un clon, solo rutas de la capa herramientas (paths.conf [allow])

set -euo pipefail

MODE="check"
if [[ "${1:-}" == "--execute" ]]; then
    MODE="execute"
    shift
elif [[ "${1:-}" == "--check" ]]; then
    shift
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ No estás dentro de un repositorio git."
    exit 1
fi

BRANCH="${2:-$(git branch --show-current)}"
REMOTE="${1:-}"

if [[ -z "$BRANCH" ]]; then
    echo "❌ No se pudo detectar la rama actual."
    exit 1
fi

if [[ -z "$REMOTE" ]]; then
    case "$BRANCH" in
        main)
            echo "❌ Push bloqueado: la rama main es espejo de upstream."
            echo "   main solo se sincroniza con: git reset --hard upstream/main"
            exit 1
            ;;
        taiko) REMOTE="origin" ;;
        *)     REMOTE="origin" ;;
    esac
fi

if ! git remote get-url "$REMOTE" >/dev/null 2>&1; then
    echo "❌ Remoto no configurado: $REMOTE"
    exit 1
fi

# Reglas de rutas (misma implementación que el hook pre-push y la GitHub Action):
# prohibidos, ramas bloqueadas en clones, allowlist de la capa herramientas, aviso de changelog.
BASE_FLAG=""
git remote get-url upstream >/dev/null 2>&1 && BASE_FLAG="--base-repo"

detect_changed_files() {
    local remote="$1"
    local branch="$2"
    if git show-ref --verify --quiet "refs/remotes/${remote}/${branch}"; then
        git --no-pager diff --name-only --diff-filter=d "${remote}/${branch}...HEAD"
    else
        git --no-pager log --pretty="" --name-only --diff-filter=d HEAD --not --remotes | sort -u
    fi
}

CHANGED_FILES="$(detect_changed_files "$REMOTE" "$BRANCH")"
if ! OUT="$(printf '%s\n' "$CHANGED_FILES" | python3 agent/scripts/check_pushed_paths.py --branch "$BRANCH" $BASE_FLAG)"; then
    echo "$OUT"
    echo "Backup del trabajo operativo → Time Machine local, nunca git."
    exit 1
fi
[[ -n "$OUT" ]] && echo "$OUT"

echo "✅ Política validada."
echo "   Rama:   $BRANCH"
echo "   Remoto: $REMOTE"
echo "   Acción recomendada: git push $REMOTE $BRANCH"

if [[ "$MODE" == "execute" ]]; then
    git push "$REMOTE" "$BRANCH"
fi
